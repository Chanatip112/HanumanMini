//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~    ARTRON ACADEMY    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

// spi.begin(SCK, MOSI, MISO, CS);      Set pin SPI         ------>   (A0 - D13)

// spi.read(Channel);                   Read SPI Channel    ------>   (0 - 7)

//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/

#include <HanumanMini.h>

void setup() {
  Serial.begin(115200);

  spi.begin(12, 10, 11, 9);  // Set pin SPI
}

void loop() {
  for (int Ch = 0; Ch < 8; Ch++) {
    Serial.print(spi.read(Ch)); //Read SPI Channel 0 - 7
    Serial.print("\t");
  }
  Serial.print("\n");

  delay(100);
}
